# ============================================================================
# UROP Language Study — environment variables
# Copy this file to .env.local for local development and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================================

# --- Supabase project (see SETUP.md) ----------------------------------------
# Public project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon"/"publishable" key. Safe to expose to the browser.
# Used ONLY for Supabase Auth (admin login) on the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Never import this into any file that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application --------------------------------------------------------
# Base URL of the deployed app (used for building absolute links, if needed).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment. Controls whether development-only bypasses can be used.
# Leave unset in production — never set to "development" on a deployed instance.
NODE_ENV=development
